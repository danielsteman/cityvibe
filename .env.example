# City Vibe - Environment Variables Example
# Copy this file to .env and update with your actual values

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string using asyncpg driver
# Format: postgresql+asyncpg://user:password@host:port/database
# For local development with Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/cityvibe
# For Neon/Cloud: postgresql+asyncpg://user:password@host.neon.tech:5432/neondb
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cityvibe

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis connection URL for caching and Celery broker
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Vector Database (Qdrant)
# ============================================================================
# Qdrant connection URL for vector embeddings and semantic search
# Format: http://host:port
QDRANT_URL=http://localhost:6333

# ============================================================================
# OpenAI Configuration
# ============================================================================
# OpenAI API key for embeddings and agent LLM calls
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# ============================================================================
# Celery Configuration
# ============================================================================
# Celery broker URL (typically Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
# Celery result backend URL (typically Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0
